<Application x:Class="SHD.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="ShellBackground" Color="#171717" />
        <SolidColorBrush x:Key="ShellSurface" Color="#222222" />
        <SolidColorBrush x:Key="ShellForeground" Color="#E8E8E8" />
        <SolidColorBrush x:Key="ShellMuted" Color="#A8A8A8" />
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}" />
            <Setter Property="Background" Value="{StaticResource ShellSurface}" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}" />
            <Setter Property="Background" Value="#292929" />
            <Setter Property="BorderBrush" Value="#454545" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}" />
            <Setter Property="Background" Value="#292929" />
            <Setter Property="Padding" Value="8,5" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#3A3A3A" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#454545" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource ShellForeground}" />
            <Setter Property="Background" Value="#222222" />
            <Setter Property="BorderBrush" Value="#303030" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </Application.Resources>
</Application>
